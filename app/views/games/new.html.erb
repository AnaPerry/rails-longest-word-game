<div class="d-flex align-items-center">
  <div class="m-4">
    <div class="container">
      <h1>New Game</h1>
      <div class="row m-4">
        <div class="col btn-info"><%= @letters [0] %></div>
        <div class="col btn-info"><%= @letters [1] %></div>
        <div class="col btn-info"><%= @letters [2] %></div>
        <div class="col btn-info"><%= @letters [3] %></div>
        <div class="col btn-info"><%= @letters [4] %></div>
        <div class="col btn-info"><%= @letters [5] %></div>
        <div class="col btn-info"><%= @letters [6] %></div>
        <div class="col btn-info"><%= @letters [7] %></div>
        <div class="col btn-info"><%= @letters [8] %></div>
        <div class="col btn-info"><%= @letters [9] %></div>
      </div>
      <form action="score" method="score" data-turbo="false" class="m-4">
        <label for="word">What is the longest word you can find?</label>
        <input type="text" id="word" name="word">
        <input type="submit" value="Submit" class = "btn btn-success">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      </form>
   </div>
  </div>
</div>
